<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{page.title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="assets/css/styles.css">
</head>

<body>
    <div class="container">


        <div class="row my-3">
            <div class="col-12 col-lg-5">
                <div class="card">

                    <img src="{{page.image}}" class="card-img-top" alt="...">
                    <div class="card-body">
                        <p class="card-title"></p>
                    </div>
                </div>
            </div>
            <div class="col">

                <div id="map"></div>

                <h5 class="my-3">API endpoints</h5>
                <ul>
                    <li><a href="./api/">./api/</a></li>
                    <li><a href="./api/location/davidson/nc">./api/location/davidson/nc</a></li>
                    <li><a href="./api/location/washington/dc">./api/location/washington/dc</a></li>
                </ul>

                <h5>Update map</h5>
                <ul>
                    <li><a href="#" class="updateMap" data-location="davidson/nc">davidson/nc</a></li>
                    <li><a href="#" class="updateMap" data-location="washington/dc">washington/dc</a></li>
                    <li><a href="#" class="updateMap" data-location="lenoir/nc">lenoir/nc</a></li>
                </ul>
            </div>
        </div>


    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="assets/js/main.js"></script>
</body>

</html>